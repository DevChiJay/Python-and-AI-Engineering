              "leftValue": "={{ $json.emails }}",
              "rightValue": "(google|gstatic|ggpht|schema\\.org|example\\.com|sentry\\.io|wixpress\\.com|noreply|no-reply|@wix\\.)"
            }
          ]
        },
        "options": {}
      },
      "id": "aaaaaaaa-0017-4000-8000-000000000017",
      "name": "Filter Spam Emails",
      "type": "n8n-nodes-base.filter",
      "position": [3120, 420],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "emails"
            }
          ]
        },
        "options": {
          "mergeLists": false
        }
      },
      "id": "aaaaaaaa-0018-4000-8000-000000000018",
      "name": "Aggregate All Emails",
      "type": "n8n-nodes-base.aggregate",
      "position": [3360, 420],
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const emails = Array.isArray($json.emails) ? $json.emails : []\n\n// Reference back to the original Telegram message for context\nconst originalText = $('Telegram Trigger').first().json.message.text || ''\n\nif (emails.length === 0) {\n  return {\n    json: {\n      messageText: `❌ No emails found for: \"${originalText}\"\\n\\nTry being more specific, e.g. \"dentists in Manhattan\" instead of \"dentists in New York\".`\n    }\n  }\n}\n\n// Telegram hard limit is 4096 chars — cap at 200 emails to stay safe\nconst cap = 200\nconst shown = emails.slice(0, cap)\nconst overflow = emails.length > cap\n  ? `\\n\\n_...showing ${cap} of ${emails.length} total emails found_`\n  : ''\n\nconst list = shown.join('\\n')\n\nreturn {\n  json: {\n    messageText: `✅ *Lead Generation Complete*\\n\\n📍 Query: \"${originalText}\"\\n📧 Emails found: *${emails.length}*\\n\\n${list}${overflow}`\n  }\n}\n"
      },
      "id": "aaaaaaaa-0019-4000-8000-000000000019",
      "name": "Format Telegram Message",
      "type": "n8n-nodes-base.code",
      "position": [3600, 420],
      "typeVersion": 2
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
        "text": "={{ $json.messageText }}",
        "additionalFields": {
