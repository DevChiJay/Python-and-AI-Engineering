        "url": "={{ $json.website }}",
        "options": {}
      },
      "id": "aaaaaaaa-0012-4000-8000-000000000012",
      "name": "Fetch Business Website",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1920, 420],
      "typeVersion": 4.2,
      "alwaysOutputData": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = $json.data || ''\nconst emailRegex = /[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\\.(?!png|jpg|gif|jpeg|svg|webp)[a-zA-Z]{2,}/g\nconst emails = html.match(emailRegex) || []\nreturn { json: { emails: emails } }\n"
      },
      "id": "aaaaaaaa-0013-4000-8000-000000000013",
      "name": "Extract Emails From Page",
      "type": "n8n-nodes-base.code",
      "position": [2160, 420],
      "typeVersion": 2,
      "onError": "continueRegularOutput"
    },
