    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Truncate immediately — real contact emails are in the first ~100KB.\n// Full pages can be 3–5 MB of minified JS; running a global regex on that hangs the runner.\nlet html = ($json.data || '').slice(0, 120_000)\n\n// Strip <script> and <style> blocks (indexOf approach — no regex backtracking risk)\nlet pos\nwhile ((pos = html.toLowerCase().indexOf('<script')) !== -1) {\n  const end = html.toLowerCase().indexOf('<\\/script>', pos)\n  if (end === -1) { html = html.slice(0, pos); break }\n  html = html.slice(0, pos) + ' ' + html.slice(end + 9)\n}\nwhile ((pos = html.toLowerCase().indexOf('<style')) !== -1) {\n  const end = html.toLowerCase().indexOf('<\\/style>', pos)\n  if (end === -1) { html = html.slice(0, pos); break }\n  html = html.slice(0, pos) + ' ' + html.slice(end + 8)\n}\n\nconst emailRegex = /[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\\.(?!png|jpg|gif|jpeg|svg|webp)[a-zA-Z]{2,}/g\n\n// Cap at 50 emails per page — prevents downstream item explosion\nconst emails = (html.match(emailRegex) || []).slice(0, 50)\n\nreturn { json: { emails } }\n"
      },
