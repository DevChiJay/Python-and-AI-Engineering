      "parameters": {
        "promptType": "define",
        "text": "={{ $('Validate & Check Rate Limit').first().json.keyword + ' in ' + $('Validate & Check Rate Limit').first().json.location }}",
        "options": {
          "systemMessage": "You are a lead generation assistant.\n\nYou will receive a message in the format \"keyword in City\" (e.g. \"dentist in New York\").\n\nGenerate exactly 10 search queries for real, distinct sub-areas or micro-neighbourhoods of that city, paired with the keyword.\n\nReturn ONLY a valid JSON array — no explanation, no markdown code blocks, no extra text before or after:\n[{\"query\":\"neighbourhood+keyword\"},{\"query\":\"area+keyword\"},...]\n\nRules:\n- Replace spaces with + in every query value\n- Put the keyword at the END of each query string\n- Use real, distinct neighbourhoods or districts of the given city\n- Generate exactly 10 items"
        }
      },
      "id": "d3f7d826-a260-42fe-a073-d59bdcdcfe93",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [8016, 2304],
      "typeVersion": 1.8
    },
    {
      "parameters": {
        "jsCode": "// Agent output is in $json.output as a string\nconst raw = ($input.first().json.output || '').trim()\n\n// Strip markdown code fences if the model wraps output in ```json ... ```\nconst cleaned = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i,     '')\n  .replace(/```\\s*$/i,     '')\n  .trim()\n\n// Extract the JSON array\nconst match = cleaned.match(/\\[[\\s\\S]*\\]/)\nif (!match) return []\n\nlet queries\ntry { queries = JSON.parse(match[0]) } catch (e) { return [] }\nif (!Array.isArray(queries)) return []\n\n// Normalise — each item must be { query: \"...\" }\nreturn queries\n  .filter(q => q && (typeof q === 'string' || typeof q.query === 'string'))\n  .map(q => ({ json: { query: typeof q === 'string' ? q : q.query } }))\n"
      },
