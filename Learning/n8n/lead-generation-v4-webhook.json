    {
      "parameters": {
        "jsCode": "// All rows from the \"API Keys\" sheet arrive as $input items\nconst allRows = $input.all()\n\n// Extract request fields from the original webhook body\nconst body = $('Webhook Trigger').first().json.body || {}\nconst apiKey    = (body.apiKey || body.api_key || '').trim()\nconst keyword   = (body.keyword  || '').trim()\nconst location  = (body.location || '').trim()\nconst userEmail = (body.email    || '').trim()\n\nconst today = new Date().toISOString().split('T')[0] // \"YYYY-MM-DD\"\n\n// Guard: must have a key\nif (!apiKey) {\n  return [{ json: { allowed: false, reason: 'missing_key', userEmail, keyword, location, apiKey: '' } }]\n}\n\n// Find matching row\nconst matchRow = allRows.find(r => (r.json.api_key || '').trim() === apiKey)\n\nif (!matchRow) {\n  return [{ json: { allowed: false, reason: 'invalid_key', userEmail, keyword, location, apiKey } }]\n}\n\nconst row = matchRow.json\n\n// Check if key is active\nconst isActive = (row.active || '').toString().toLowerCase().trim() === 'yes'\nif (!isActive) {\n  return [{ json: { allowed: false, reason: 'inactive_key', userEmail, keyword, location, apiKey } }]\n}\n\n// Daily limit check (reset count if last_reset is before today)\nconst limit      = parseInt(row.daily_limit) || 5\nconst lastReset  = (row.last_reset || '').trim()\nconst isNewDay   = !lastReset || lastReset < today\nconst currentCnt = isNewDay ? 0 : parseInt(row.daily_count) || 0\nconst newCount   = currentCnt + 1\n\nif (newCount > limit) {\n  return [{\n    json: {\n      allowed: false,\n      reason: 'rate_limited',\n      userEmail, keyword, location, apiKey,\n      remaining: 0,\n      resetDate: today  // they can try again tomorrow\n    }\n  }]\n}\n\nreturn [{\n  json: {\n    allowed: true,\n    apiKey,\n    newCount,\n    today,\n    keyword,\n    location,\n    userEmail,\n    remaining: limit - newCount\n  }\n}]\n"
      },
