    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const emails = Array.isArray($json.emails) ? $json.emails : []\n\n// Back-reference original request context from the validation node\nconst ctx       = $('Validate & Check Rate Limit').first().json\nconst keyword   = ctx.keyword   || ''\nconst location  = ctx.location  || ''\nconst userEmail = ctx.userEmail || ''\nconst remaining = ctx.remaining !== undefined ? ctx.remaining : '?'\n\nconst subject = `Lead Generation Results: ${keyword} in ${location}`\n\nif (emails.length === 0) {\n  return {\n    json: {\n      toEmail: userEmail,\n      subject,\n      emailBody: `<html><body style=\"font-family:sans-serif;max-width:580px;margin:40px auto\">\n<h2>Lead Generation Complete</h2>\n<p><strong>Keyword:</strong> ${keyword}<br><strong>Location:</strong> ${location}</p>\n<p>No email addresses were found for this search. Try a different keyword or a more populated location.</p>\n<p style=\"color:#888\">Requests remaining today: ${remaining}</p>\n</body></html>`\n    }\n  }\n}\n\nconst cap   = 500\nconst shown = emails.slice(0, cap)\nconst more  = emails.length > cap\n  ? `<p><em>Showing first ${cap} of ${emails.length} results.</em></p>` : ''\n\nconst list = shown.map(e => `<li style=\"font-family:monospace;margin:2px 0\">${e}</li>`).join('\\n')\n\nreturn {\n  json: {\n    toEmail: userEmail,\n    subject,\n    emailBody: `<html><body style=\"font-family:sans-serif;max-width:580px;margin:40px auto\">\n<h2>Lead Generation Results</h2>\n<table style=\"border-collapse:collapse;margin-bottom:16px\">\n  <tr><td style=\"padding:4px 12px 4px 0;font-weight:bold\">Keyword</td><td>${keyword}</td></tr>\n  <tr><td style=\"padding:4px 12px 4px 0;font-weight:bold\">Location</td><td>${location}</td></tr>\n  <tr><td style=\"padding:4px 12px 4px 0;font-weight:bold\">Emails Found</td><td><strong>${emails.length}</strong></td></tr>\n  <tr><td style=\"padding:4px 12px 4px 0;font-weight:bold\">Remaining Today</td><td>${remaining} of 5 requests</td></tr>\n</table>\n${more}\n<h3>Email Addresses</h3>\n<ul style=\"line-height:1.9;padding-left:20px\">\n${list}\n</ul>\n<hr style=\"margin-top:40px\">\n<p style=\"color:#aaa;font-size:12px\">Lead Generator &mdash; automated message.</p>\n</body></html>`\n  }\n}\n"
      },
