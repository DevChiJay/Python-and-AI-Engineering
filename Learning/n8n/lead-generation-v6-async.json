    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.output || '').trim()\nconst cleaned = raw.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '').trim()\nconst match = cleaned.match(/\\[[\\s\\S]*\\]/)\nif (!match) return []\nlet queries\ntry { queries = JSON.parse(match[0]) } catch (e) { return [] }\nif (!Array.isArray(queries)) return []\nreturn queries\n  .filter(q => q && (typeof q === 'string' || typeof q.query === 'string'))\n  .map(q => ({ json: { query: typeof q === 'string' ? q : q.query } }))\n"
      },
