    {
      "parameters": {
        "jsCode": "const jobId = $('Status Webhook').first().json.query.jobId || ''\n\nconst jobsInput   = $input.all()\nconst jobRow = jobsInput.find(i => (i.json.job_id || '') === jobId)\n\nif (!jobRow) {\n  return [{ json: { found: false, jobId } }]\n}\n\nconst leads = jobsInput\n  .filter(i => (i.json.job_id || '') === jobId && i.json.business_name !== undefined)\n  .map(i => ({\n    business_name: i.json.business_name,\n    phone: i.json.phone,\n    website: i.json.website,\n    address: i.json.address,\n    email: i.json.email\n  }))\n\nreturn [{\n  json: {\n    found: true,\n    jobId,\n    status: jobRow.json.status,\n    keyword: jobRow.json.keyword,\n    location: jobRow.json.location,\n    total_written: parseInt(jobRow.json.total_written) || 0,\n    leads\n  }\n}]\n"
      },
