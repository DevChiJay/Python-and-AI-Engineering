      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [1720, 600],
      "typeVersion": 1.3,
      "credentials": {
        "openAiApi": { "id": "uQKAaZsBCZc8tSsG", "name": "OpenAI account" }
