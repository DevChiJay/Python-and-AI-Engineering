            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v6-cond-has-url",
              "operator": { "type": "string", "operation": "notEmpty" },
              "leftValue": "={{ $json.candidateUrl || '' }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },
      "id": "v6-0018",
      "name": "IF: Has Candidate URL",
      "type": "n8n-nodes-base.filter",
      "position": [3400, 320],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "url": "={{ $json.candidateUrl }}",
        "options": { "timeout": 8000 }
      },
      "id": "v6-0019",
      "name": "Fetch Candidate Page",
      "type": "n8n-nodes-base.httpRequest",
      "position": [3640, 320],
      "typeVersion": 4.2,
      "alwaysOutputData": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let html = ($json.data || '').slice(0, 120_000)\nlet pos\nwhile ((pos = html.toLowerCase().indexOf('<script')) !== -1) {\n  const end = html.toLowerCase().indexOf('<\\/script>', pos)\n  if (end === -1) { html = html.slice(0, pos); break }\n  html = html.slice(0, pos) + ' ' + html.slice(end + 9)\n}\nwhile ((pos = html.toLowerCase().indexOf('<style')) !== -1) {\n  const end = html.toLowerCase().indexOf('<\\/style>', pos)\n  if (end === -1) { html = html.slice(0, pos); break }\n  html = html.slice(0, pos) + ' ' + html.slice(end + 8)\n}\n\nconst emailRegex = /[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\\.(?!png|jpg|gif|jpeg|svg|webp)[a-zA-Z]{2,}/g\nconst junk = /(google|gstatic|ggpht|schema\\.org|example\\.com|sentry\\.io|wixpress\\.com|@wix\\.)/i\nconst found = (html.match(emailRegex) || []).filter(e => !junk.test(e))\n\n// HTTP Request node replaces $json with the response, so pull business fields back from the upstream node\nconst orig = $('Generate Candidate URLs').item.json\nreturn { json: { ...orig, emails: found } }\n"
      },
