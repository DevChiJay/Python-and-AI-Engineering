        "promptType": "define",
        "text": "={{ $('Validate & Check Rate Limit').first().json.keyword + ' in ' + $('Validate & Check Rate Limit').first().json.location }}",
        "options": {
          "systemMessage": "You are a lead generation assistant.\n\nYou will receive a message in the format \"keyword in City\" (e.g. \"dentist in New York\").\n\nGenerate exactly 25 search queries for real, distinct sub-areas or micro-neighbourhoods of that city, paired with the keyword.\n\nReturn ONLY a valid JSON array — no explanation, no markdown code blocks, no extra text before or after:\n[{\"query\":\"neighbourhood+keyword\"},{\"query\":\"area+keyword\"},...]\n\nRules:\n- Replace spaces with + in every query value\n- Put the keyword at the END of each query string\n- Use real, distinct neighbourhoods or districts of the given city\n- Generate exactly 25 items"
        }
      },
