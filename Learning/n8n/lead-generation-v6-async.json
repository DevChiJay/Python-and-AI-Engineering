    {
      "parameters": {
        "jsCode": "const allRows = $input.all()\nconst body = $('Submit Webhook').first().json.body || {}\nconst apiKey   = (body.apiKey || body.api_key || '').trim()\nconst keyword  = (body.keyword  || '').trim()\nconst location = (body.location || '').trim()\n\nconst today  = new Date().toISOString().split('T')[0]\nconst jobId  = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID()\n             : `${Date.now()}-${Math.random().toString(36).slice(2)}`\n\nif (!apiKey) {\n  return [{ json: { allowed: false, reason: 'missing_key', jobId, keyword, location } }]\n}\n\nconst matchRow = allRows.find(r => (r.json.api_key || '').trim() === apiKey)\nif (!matchRow) {\n  return [{ json: { allowed: false, reason: 'invalid_key', jobId, keyword, location } }]\n}\n\nconst row = matchRow.json\nconst isActive = (row.active || '').toString().toLowerCase().trim() === 'yes'\nif (!isActive) {\n  return [{ json: { allowed: false, reason: 'inactive_key', jobId, keyword, location } }]\n}\n\nconst limit      = parseInt(row.daily_limit) || 5\nconst lastReset  = (row.last_reset || '').trim()\nconst isNewDay   = !lastReset || lastReset < today\nconst currentCnt = isNewDay ? 0 : parseInt(row.daily_count) || 0\nconst newCount   = currentCnt + 1\n\nif (newCount > limit) {\n  return [{ json: { allowed: false, reason: 'rate_limited', jobId, keyword, location, remaining: 0 } }]\n}\n\nreturn [{\n  json: {\n    allowed: true, apiKey, newCount, today, keyword, location, jobId,\n    remaining: limit - newCount\n  }\n}]\n"
      },
