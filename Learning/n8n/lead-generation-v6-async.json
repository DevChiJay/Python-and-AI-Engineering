    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const p = item.json\n  const website = (p.website || '').trim()\n  const dedupeKey = website || `${(p.title || '').trim()}|${(p.address || '').trim()}`\n  return { json: {\n    dedupeKey,\n    business_name: p.title || '',\n    phone: p.phoneNumber || p.phone || '',\n    website,\n    address: p.address || ''\n  } }\n})\n"
      },
      "id": "v6-0015",
      "name": "Normalize Business Fields",
      "type": "n8n-nodes-base.code",
      "position": [2680, 400],
      "typeVersion": 2
    },
    {
      "parameters": {
        "compare": "selectedFields",
        "fieldsToCompare": "dedupeKey",
        "options": {}
      },
      "id": "v6-0016",
      "name": "Remove Duplicate Businesses",
      "type": "n8n-nodes-base.removeDuplicates",
      "position": [2920, 400],
      "typeVersion": 1.1
    },
    {
      "parameters": {
        "jsCode": "const results = []\nfor (const item of $input.all()) {\n  const b = item.json\n  if (!b.website) {\n    results.push({ json: { ...b, candidateUrl: null } })\n    continue\n  }\n  const base = b.website.replace(/\\/$/, '')\n  const paths = ['', '/contact', '/contact-us', '/about']\n  for (const p of paths) {\n    results.push({ json: { ...b, candidateUrl: base + p } })\n  }\n}\nreturn results\n"
      },
      "id": "v6-0017",
      "name": "Generate Candidate URLs",
      "type": "n8n-nodes-base.code",
      "position": [3160, 400],
      "typeVersion": 2
    },
    {
      "parameters": {
        "conditions": {
          "options": {
