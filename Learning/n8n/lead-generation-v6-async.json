      "type": "n8n-nodes-base.merge",
      "position": [4120, 400],
      "typeVersion": 3
    },
    {
      "parameters": {
        "jsCode": "const groups = new Map()\nfor (const item of $input.all()) {\n  const b = item.json\n  const key = b.dedupeKey\n  if (!groups.has(key)) {\n    groups.set(key, { business_name: b.business_name, phone: b.phone, website: b.website, address: b.address, email: '' })\n  }\n  const g = groups.get(key)\n  if (!g.email && Array.isArray(b.emails) && b.emails.length > 0) {\n    g.email = b.emails[0]\n  }\n}\nreturn Array.from(groups.values()).map(v => ({ json: v }))\n"
      },
